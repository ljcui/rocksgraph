#!/usr/bin/env bash
set -euo pipefail

if ! command -v clang-format >/dev/null 2>&1; then
  echo "pre-commit: clang-format is not installed; commit aborted." >&2
  exit 1
fi

mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACM -z -- '*.h' '*.hpp' '*.cc' '*.cpp' '*.cxx')

if [[ ${#files[@]} -eq 0 ]]; then
  exit 0
fi

printf '%s\0' "${files[@]}" | xargs -0 clang-format -i
printf '%s\0' "${files[@]}" | xargs -0 git add --

echo "pre-commit: auto-formatted and re-staged ${#files[@]} C/C++ file(s)."
